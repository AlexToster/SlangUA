{
  "name": "slangua-backend",
  "version": "1.0.0",
  "description": "SlangUA Backend - Fastify API for Telegram Mini App",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && node scripts/copy-style-assets.mjs",
    "start": "node dist/app.js",
    "test": "npm run test:typecheck && npm run test:smoke && npm run test:integration",
    "test:smoke": "npm run build && node test/verify-style-engine.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@google/generative-ai": "^0.24.1",
    "@openrouter/sdk": "^1.2.27",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^1.2.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.2",
    "ollama": "^0.6.3",
    "openai": "^7.4.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "prisma": "^5.22.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
