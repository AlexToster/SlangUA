.git
.env
.env.*
!.env.example
node_modules
frontend/node_modules
dist
frontend/dist
SlangUA.zip
*.tar.gz
*.log

# Database dumps must never enter an image layer. The db-backup service reads the
# script through a bind mount, not from the build context, so nothing here needs
# the backups directory.
backups
*.sql.gz

# Local deploy scripts hold production server details and must never enter the
# build context or an image layer. Only deploy/nginx/* is used (see Dockerfile).
deploy/*.ps1
deploy/*.sh

# Tests never take part in the production image. The frontend build runs only the
# app and node TypeScript projects, so a leftover test file in the build context
# (e.g. an older copy still sitting in /opt/slangua from a previous deploy) can no
# longer break `npm run build`.
test
frontend/src/test
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx
