# Dependencies
node_modules/

# Build output
dist/
dist-test/
frontend/dist/

# Deployment archives
*.tar.gz

# Local deploy scripts. They carry production server details (hosts, paths,
# credentials) and are kept outside the repository on purpose - only the nginx
# templates under deploy/ belong here.
deploy/*.ps1
deploy/*.sh

# Database dumps. The default BACKUP_DIR of the db-backup service is ./backups,
# so a full copy of production data can appear here; *.sql.gz is listed as well
# because a hand-taken dump usually lands wherever the operator happens to be.
backups/
*.sql.gz

# Environment files (secrets)
.env
.env.*.local

# Logs
*.log

# Coverage
coverage/

# OS/Editor junk
.DS_Store
.idea/
.vscode/

# Postman (local workspace artifacts)
postman/
.postman/
