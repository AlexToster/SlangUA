server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        # Both values differ from the nginx defaults on purpose; the reasoning is
        # spelled out in slangua.https.conf.template, and the two files must not
        # drift apart - this template is the bootstrap step before the certificate
        # exists, not a lighter configuration.
        #
        # 1m would cut off POST /api/v1/transcribe, whose base64 body reaches about
        # 1.34 MiB at the default STT_MAX_AUDIO_BYTES.
        client_max_body_size 2m;
        # 60s would end a translation that is still legitimately running through the
        # provider fallback chain.
        proxy_read_timeout 120s;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
