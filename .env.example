# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/slangua?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Refresh Token HMAC Secret (for hashing refresh tokens before storing in DB)
REFRESH_TOKEN_HMAC_SECRET=your-refresh-token-hmac-secret-min-32-chars

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_INLINE_ENABLED=false
# Set this when configuring Telegram setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=
AUTH_DATE_TTL=86400

# AI Provider API Keys (at least one required)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=

# AI Provider Model Names
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-3-haiku-20240307
AI_MODEL_GEMINI=gemini-3.6-flash
AI_MODEL_OLLAMA=llama3.1:8b
AI_MODEL_OPENROUTER=nvidia/nemotron-3-nano-30b-a3b:free

# AI Provider Priority (comma-separated, order matters for fallback)
AI_PROVIDER_PRIORITY=openai,anthropic,gemini,ollama,openrouter

# AI Provider Timeouts (milliseconds)
AI_TIMEOUT_OPENAI=30000
AI_TIMEOUT_ANTHROPIC=30000
AI_TIMEOUT_GEMINI=30000
AI_TIMEOUT_OLLAMA=60000
AI_TIMEOUT_OPENROUTER=30000

# AI Provider Retry Policy
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=1000
AI_MAX_FALLBACK_ATTEMPTS=3  # Max fallback attempts across providers

# Ollama
OLLAMA_BASE_URL=http://localhost:11434  # Ollama API base URL

# Rate Limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Preview Rate Limiting (separate from persistent translate)
PREVIEW_RATE_LIMIT_WINDOW_MS=60000
PREVIEW_RATE_LIMIT_MAX_REQUESTS=12
PREVIEW_RATE_LIMIT_KEY_PREFIX=ratelimit:preview

# Save Rate Limiting (separate from preview and persistent translate)
SAVE_RATE_LIMIT_WINDOW_MS=60000
SAVE_RATE_LIMIT_MAX_REQUESTS=10
SAVE_RATE_LIMIT_KEY_PREFIX=ratelimit:save

# Preview Cache
PREVIEW_CACHE_TTL_SECONDS=600
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PREVIEW_ROOT_KEY=replace-with-a-base64-encoded-32-byte-random-key
PREVIEW_KEY_VERSION=v1

# Telegram-native sharing
SHARE_CACHE_TTL_SECONDS=600
SHARE_RATE_LIMIT_WINDOW_MS=60000
SHARE_RATE_LIMIT_MAX_REQUESTS=10
SHARE_RATE_LIMIT_KEY_PREFIX=ratelimit:share

# Logging
LOG_LEVEL=info
