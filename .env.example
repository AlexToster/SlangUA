# ---------------------------------------------------------------------------
# SlangUA environment configuration
#
# Mirrors the Zod schema in src/config/index.ts. Values below are the schema
# defaults, so a straight copy of this file reproduces documented behaviour.
# REQUIRED = no default in the schema; the process exits at boot when the value
# is missing or invalid. Commented-out lines are optional variables with no
# default, where "unset" is meaningful and an empty value is not the same thing.
#
# Every secret below is a placeholder: the "example-only" values and the dummy
# PREVIEW_ROOT_KEY are rejected at boot when NODE_ENV=production, so a straight
# copy of this file cannot be deployed as-is.
#
# A value containing a '$' must be single-quoted. In production this file is read
# by Docker Compose (env_file in docker-compose.production.yml), not by dotenv,
# and Compose interpolates unquoted and double-quoted values: $N becomes a
# reference to a variable that does not exist and is replaced with an empty
# string. Single quotes disable that, and both parsers strip them, so the quoted
# line works locally and in the container alike. '$$' is not an alternative here:
# dotenv does not unescape it.
# ---------------------------------------------------------------------------

# Server
# development | production | test
NODE_ENV=development
PORT=3000
# Bind address; 0.0.0.0 also accepts connections from outside the container
HOST=0.0.0.0

# Database (PostgreSQL)
# REQUIRED - must be a valid URL
DATABASE_URL=postgresql://user:password@localhost:5432/slangua?schema=public

# Redis
# REQUIRED - must be a valid URL. Rate limiting and the preview cache both
# depend on Redis; request admission fails closed when it is unavailable.
REDIS_URL=redis://localhost:6379

# JWT
# REQUIRED - min 32 characters; signs and verifies access tokens
JWT_SECRET=example-only-jwt-secret-replace-me-32-chars-min
# Access token lifetime
JWT_ACCESS_TTL=15m
# Refresh cookie lifetime; must use s, m, h or d units (parsed in routes/auth.ts)
JWT_REFRESH_TTL=7d

# Refresh Token HMAC
# REQUIRED - min 32 characters; HMAC key used to hash refresh tokens at rest
REFRESH_TOKEN_HMAC_SECRET=example-only-refresh-hmac-secret-replace-me-32

# Telegram
# REQUIRED - bot token from BotFather; also the initData HMAC secret
TELEGRAM_BOT_TOKEN=123456789:example-only-bot-token-replace-me
# Enables POST /api/v1/telegram/webhook and POST /api/v1/share/inline
TELEGRAM_INLINE_ENABLED=false
# Must equal the secret_token passed to Telegram setWebhook, and is required
# (non-empty) when TELEGRAM_INLINE_ENABLED=true. An empty value fails
# validation, so keep the line commented out while inline sharing is off.
#TELEGRAM_WEBHOOK_SECRET=example-only-webhook-secret-replace-me
# Max accepted age of the Telegram initData auth_date, in seconds (24 h)
AUTH_DATE_TTL=86400

# AI Provider API Keys
# Optional and unset by default. A provider is enabled only when its key is
# present (see provider.factory.ts), so set at least one - or rely on Ollama,
# which needs no key and is enabled outside production.
#
# Each variable accepts a comma-separated list of keys: a key that is out of
# limit is parked for a cooldown and the next one serves the request. Whitespace
# around a key is trimmed and duplicates are dropped. Check the vendor's terms
# before pooling keys - some forbid holding multiple free-tier accounts.
#OPENAI_API_KEY=sk-example-only-openai-key
#ANTHROPIC_API_KEY=sk-ant-example-only-anthropic-key
#GEMINI_API_KEY=example-only-gemini-key-1,example-only-gemini-key-2
#OPENROUTER_API_KEY=sk-or-example-only-openrouter-key

# AI Key Cooldowns (milliseconds a spent key stays parked)
# rate = short-term limit (requests per minute), quota = spent budget,
# invalid = key the provider rejected.
AI_KEY_COOLDOWN_RATE_MS=60000
AI_KEY_COOLDOWN_QUOTA_MS=3600000
AI_KEY_COOLDOWN_INVALID_MS=3600000

# AI Provider Model Names
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-3-haiku-20240307
AI_MODEL_GEMINI=gemini-3.6-flash
AI_MODEL_OLLAMA=llama3.1:8b
AI_MODEL_OPENROUTER=nvidia/nemotron-3-nano-30b-a3b:free

# Base URLs of the OpenAI-compatible instances (must include the API version
# segment). One adapter class serves all of them, so pointing a provider at
# another compatible endpoint - Groq, DeepSeek, vLLM, a proxy - is a config
# change, not a code change. Ollama has no variable of its own: /v1 is appended
# to OLLAMA_BASE_URL below.
AI_BASE_URL_OPENAI=https://api.openai.com/v1
AI_BASE_URL_OPENROUTER=https://openrouter.ai/api/v1

# Extra OpenAI-compatible instances
# Comma-separated instance ids, e.g. "groq,deepseek". Lowercase [a-z0-9_-], max
# 32 characters, and an id may not shadow a built-in provider (openai,
# anthropic, gemini, ollama, openrouter). Each id <ID> is configured through
# AI_BASE_URL_<ID>, AI_MODEL_<ID>, <ID>_API_KEY and the optional AI_TIMEOUT_<ID>
# (default 30000); an instance missing its base URL, model or key is skipped with
# an error log rather than failing boot. The id is what the API returns as
# providerId and what AI_PROVIDER_PRIORITY refers to.
AI_EXTRA_INSTANCES=
#AI_EXTRA_INSTANCES=groq
#AI_BASE_URL_GROQ=https://api.groq.com/openai/v1
#AI_MODEL_GROQ=llama-3.3-70b-versatile
#GROQ_API_KEY=example-only-groq-key
#AI_TIMEOUT_GROQ=30000

# AI Provider Priority
# Comma-separated instance ids; order defines the fallback chain. Every
# configured instance takes part - one this list does not mention sorts last
# rather than being disabled. An unknown id is ignored with a warning.
AI_PROVIDER_PRIORITY=openai,anthropic,gemini,ollama,openrouter

# AI Provider Timeouts (milliseconds, per request attempt)
AI_TIMEOUT_OPENAI=30000
AI_TIMEOUT_ANTHROPIC=30000
AI_TIMEOUT_GEMINI=30000
AI_TIMEOUT_OLLAMA=60000
AI_TIMEOUT_OPENROUTER=30000

# AI Provider Retry
# Retries within a single provider before falling back to the next one
AI_MAX_RETRIES=2
# Base delay between retries, in milliseconds
AI_RETRY_DELAY_MS=1000
# How many providers a single request may try. Unset means "as many as there are
# enabled providers", which is the recommended default.
#AI_MAX_FALLBACK_ATTEMPTS=3

# Circuit Breaker
# Consecutive failures before a provider's circuit opens and it is skipped
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# How long an open circuit stays open before the provider is retried, in ms
CIRCUIT_BREAKER_RESET_MS=60000

# Ollama
# Base URL of the local Ollama server. The OpenAI-compatible path /v1 is
# appended by provider.factory.ts, so this value carries the host only.
OLLAMA_BASE_URL=http://localhost:11434
# true | false. Ollama has no API key, so it cannot be enabled by key presence
# like the other providers. Left unset it follows NODE_ENV: enabled outside
# production, disabled in production (where a forgotten localhost provider would
# sit in the fallback chain and burn a timeout on every request).
#OLLAMA_ENABLED=true

# ---------------------------------------------------------------------------
# Speech-to-text (voice input in the text field)
# ---------------------------------------------------------------------------
# Own keys on purpose: transcription is not translation, and a spent
# transcription quota must not park a key the translator still needs. Leave
# STT_API_KEY empty and the microphone button disappears - the endpoint answers
# 503 STT_UNAVAILABLE and the client stops offering the feature.
#
# Comma-separated list, rotated exactly like the AI keys: a key that is
# rate-limited or out of quota is parked for a cooldown and the next one serves
# the request, which is what makes a free tier usable for several users.
STT_API_KEY=
# OpenAI-compatible /v1/audio/transcriptions endpoint, including the version
# segment. Default is Groq, whose free tier serves whisper-large-v3-turbo.
# OpenAI itself would be https://api.openai.com/v1.
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
# Language hint. Set explicitly rather than left to autodetection: the input is
# Ukrainian colloquial speech, and Whisper mistakes short Ukrainian clips for
# Russian often enough to matter.
STT_LANGUAGE=uk
STT_TIMEOUT_MS=30000
# Server-side ceiling on the decoded audio. The client caps recording at 30 s
# (~120 KB of Opus); 1 MiB leaves room for iOS's less efficient AAC without
# turning the endpoint into a file-upload channel.
STT_MAX_AUDIO_BYTES=1048576

# How long an exhausted transcription key stays parked, in ms. Same three kinds
# as AI_KEY_COOLDOWN_*: rate = short-term limit, quota = spent budget,
# invalid = rejected key.
STT_KEY_COOLDOWN_RATE_MS=60000
STT_KEY_COOLDOWN_QUOTA_MS=3600000
STT_KEY_COOLDOWN_INVALID_MS=3600000

# Transcription Rate Limiting (own budget: one request carries audio and spends
# upstream quota shared by every user of the app)
STT_RATE_LIMIT_WINDOW_MS=60000
STT_RATE_LIMIT_MAX_REQUESTS=6
STT_RATE_LIMIT_KEY_PREFIX=ratelimit:stt

# Rate Limiting
# Coarse per-IP limit applied to every route except /health
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
# Default per-user limit for history and persistent /translate
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Rate Limiting
# POST /auth/telegram and POST /auth/refresh are keyed by IP (no authenticated
# user exists yet) and both mint tokens, so they get their own tighter budget.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX_REQUESTS=20

# Preview Rate Limiting (separate from persistent translate)
PREVIEW_RATE_LIMIT_WINDOW_MS=60000
PREVIEW_RATE_LIMIT_MAX_REQUESTS=12
# Redis key namespace for this limiter
PREVIEW_RATE_LIMIT_KEY_PREFIX=ratelimit:preview

# Save Rate Limiting (separate from preview and persistent translate)
SAVE_RATE_LIMIT_WINDOW_MS=60000
SAVE_RATE_LIMIT_MAX_REQUESTS=10
SAVE_RATE_LIMIT_KEY_PREFIX=ratelimit:save

# Preview Cache
# How long an unsaved preview stays resolvable, in seconds (10 min)
PREVIEW_CACHE_TTL_SECONDS=600
# REQUIRED - base64 of exactly 32 random bytes; HKDF derives the per-domain keys
# that encrypt cached previews and share payloads. The value below is a
# deterministic dummy for local use only.
# Generate a real one with: openssl rand -base64 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PREVIEW_ROOT_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
# Label stamped into derived keys; bump it to invalidate every cached payload
PREVIEW_KEY_VERSION=v1

# Telegram share payloads
# Lifetime of an inline share token, in seconds (10 min)
SHARE_CACHE_TTL_SECONDS=600
SHARE_RATE_LIMIT_WINDOW_MS=60000
SHARE_RATE_LIMIT_MAX_REQUESTS=10
SHARE_RATE_LIMIT_KEY_PREFIX=ratelimit:share

# Telegram Webhook Rate Limiting
# Applies to POST /api/v1/telegram/webhook, keyed by caller IP
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=30
WEBHOOK_RATE_LIMIT_KEY_PREFIX=ratelimit:webhook

# Trust Proxy
# true | false. Enable only behind a reverse proxy you control, so that
# X-Forwarded-For is used for rate-limit keys instead of the proxy's own IP.
TRUST_PROXY=false

# CORS
# Comma-separated list of allowed browser origins (credentials are allowed)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Admin panel
# Comma-separated Telegram user ids allowed into /api/v1/admin/*. Empty (the
# default) turns the whole surface off: the app shows no admin entry point and
# every /admin/* route answers 404, the same answer a stranger gets.
ADMIN_TELEGRAM_IDS=
# scrypt hash of the admin password, format
# scrypt$N=16384,r=8,p=1$<salt base64>$<key base64>
# Generate with: node scripts/hash-admin-password.mjs
# Wrap the value in single quotes when you paste it in - it always carries three
# '$', so an unquoted line loses $N and $p to Compose interpolation and the app
# refuses to boot on a hash that is in fact correct:
# ADMIN_PASSWORD_HASH='scrypt$N=16384,r=8,p=1$<salt>$<key>'
# Deliberately empty here instead of carrying an example value: a working
# example hash would be a publicly known password. Boot fails when
# ADMIN_TELEGRAM_IDS is set and this is not.
ADMIN_PASSWORD_HASH=
# Session lifetime after a successful password check. The idle window slides on
# every admin request; the absolute one never does, so a stolen admin token
# expires within 8 hours no matter how actively it is used.
ADMIN_SESSION_TTL_SECONDS=900
ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=28800
# Password attempts. The sliding window answers 429; independently of it, after
# ADMIN_LOGIN_MAX_FAILURES wrong passwords the Telegram id is locked out for
# ADMIN_LOGIN_LOCKOUT_MS. The global 100/min budget is no defence against
# password guessing, hence the separate counters.
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=300000
ADMIN_LOGIN_RATE_LIMIT_MAX=5
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_MS=900000
# Budget for the admin endpoints themselves, keyed by the admin's user id
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX_REQUESTS=120

# Admin observability (GET /admin/metrics and GET /admin/errors)
# Everything below lives in Redis only and expires by itself: counters carry an
# absolute expiry derived from their own bucket, and the error feed is one
# capped list with a whole-key TTL. Nothing prunes, and nothing reaches Postgres.
# Length of the per-minute series the panel draws, in minutes.
METRICS_MINUTE_SERIES_LENGTH=60
# How many UTC days of daily rows to keep. Retention *is* the key expiry.
METRICS_RETENTION_DAYS=7
# How many of today's heaviest users the panel lists, by internal user id.
METRICS_TOP_USERS_LIMIT=10
# Size of the error feed. It is a window on recent failures, not an archive:
# the pino logs keep the stack and the full message.
ADMIN_ERROR_FEED_MAX=100
# Whole-key lifetime of the feed, refreshed on every write, so a quiet week
# empties it on its own. There is deliberately no endpoint that clears it.
ADMIN_ERROR_FEED_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Deployment-only variables
#
# Everything below is read by Docker Compose, not by the application: these names
# do not appear in the Zod schema in src/config/index.ts and setting them locally
# changes nothing. Compose reads this file twice in production - as `env_file` for
# the api container, and as its own interpolation source for
# docker-compose.production.yml - which is why they live here rather than in a
# second file.
# ---------------------------------------------------------------------------

# Postgres superuser password for the `db` service, and the same value inside the
# DATABASE_URL that Compose builds for the api container. REQUIRED in production:
# `docker compose up` fails with a named error when it is unset. Local runs
# against an existing Postgres do not need it - DATABASE_URL above already
# carries the credentials.
POSTGRES_PASSWORD=example-only-change-me

# Postgres backups (the db-backup service; see docs/operations.md)
# Host directory for the dumps, bind-mounted into the container at /backups.
# Files land there root-owned in daily/ and weekly/. Anywhere outside the
# repository is a better choice on a real server - /var/backups/slangua, say -
# because a dump inside the working copy is one `docker compose down -v` away
# from being the only copy left, on the same disk as the database it protects.
BACKUP_DIR=./backups
# Time of the daily dump, HH:MM in UTC. The container refuses to start on
# anything else, so a typo is not a silent "never back up".
BACKUP_AT=03:30
# How many dumps to keep. The Sunday dump is additionally hard-linked into
# weekly/, so 7 + 4 covers a week of days and a month of Sundays without storing
# the Sunday dump twice.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Optional dead-man's switch, requested after a *successful* dump and never at
# any other time. Leave it empty and nothing changes. Set it to a URL from a
# service that alerts on silence (Healthchecks.io, Better Stack, an UptimeRobot
# heartbeat monitor) and a backup that stopped running becomes a message rather
# than a discovery made during a restore - the container restarting is covered
# already, a pg_dump that fails every night is not. Treat the URL as a secret:
# whoever has it can keep the monitor quiet while the dumps stop.
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
