datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int            @id @default(autoincrement())
  telegramId        String         @unique
  username          String?
  firstName         String?
  lastName          String?
  languageCode      String?
  defaultSlangStyle SlangStyle?
  notificationsEnabled Boolean     @default(true)
  ageConfirmedAdult  Boolean       @default(false)
  createdAt         DateTime       @default(now())
  translations      Translation[]
  refreshTokens     RefreshToken[]
}

model Translation {
  id             Int        @id @default(autoincrement())
  userId         Int
  previewId      String?    @unique
  originalText   String
  translatedText String
  slangStyle     SlangStyle
  aiProvider     AIProvider
  favorite       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt, id])
  // pg_trgm GIN indexes for full-text search are created via raw SQL migration
  // @@index([originalText], map: "Translation_originalText_trgm_idx", type: Gin)
  // @@index([translatedText], map: "Translation_translatedText_trgm_idx", type: Gin)
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  userId      Int
  hashedToken String   @unique
  expiresAt   DateTime
  deviceInfo  Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

enum SlangStyle {
  GEN_Z
  STREET
  IT_SLANG
  POFENI
  KANCLER
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  OLLAMA
  OPENROUTER
}
