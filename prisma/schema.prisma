datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int            @id @default(autoincrement())
  telegramId        String         @unique
  username          String?
  firstName         String?
  lastName          String?
  languageCode      String?
  defaultSlangStyle SlangStyle?
  notificationsEnabled Boolean     @default(true)
  ageConfirmedAdult  Boolean       @default(false)
  createdAt         DateTime       @default(now())
  translations      Translation[]
  refreshTokens     RefreshToken[]
}

model Translation {
  id             Int        @id @default(autoincrement())
  userId         Int
  previewId      String?    @unique
  originalText   String
  translatedText String
  slangStyle     SlangStyle
  styleVersion   String?    // version from registry.json at time of creation
  // Which configured AI instance served this translation, e.g. "openai",
  // "openrouter", "groq". A free-form lowercase id rather than an enum: adding a
  // provider is a config change (see AI_EXTRA_INSTANCES), and an enum would make
  // it a schema migration. Validated against PROVIDER_ID_PATTERN before use.
  providerId     String
  favorite       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt, id])
  // Trigram GIN indexes behind the ILIKE '%term%' history search. Declared here
  // rather than in raw SQL only: the first pair lived in migration
  // 20260804171200 alone and the next generated migration dropped them as drift.
  // The pg_trgm extension itself is created by the migration SQL.
  @@index([originalText(ops: raw("gin_trgm_ops"))], map: "Translation_originalText_trgm_idx", type: Gin)
  @@index([translatedText(ops: raw("gin_trgm_ops"))], map: "Translation_translatedText_trgm_idx", type: Gin)
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  userId      Int
  hashedToken String   @unique
  expiresAt   DateTime
  deviceInfo  Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

enum SlangStyle {
  GEN_Z
  STREET
  IT_SLANG
  POFENI
  KANCLER
  GALICIAN
}
